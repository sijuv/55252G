// 2. Create an array of function pointers
// We pad index 0 with a nullptr so that step_1 aligns with index [1].
typedef void (*RoutineFunction)();

RoutineFunction routines[21] = {
    nullptr, // Index 0 (unused)
    step_1, step_2, step_3, step_4, step_5,
    step_6, step_7, step_8, step_9, step_10,
    step_11, step_12, step_13, step_14, step_15,
    step_16, step_17, step_18, step_19, step_20
};

void opcontrol() {
    pros::Controller master(pros::E_CONTROLLER_MASTER);
    
    int current_step = 1;
    
    // Print and run the initial step on startup
    pros::lcd::print(2, "Current Step: %d", current_step);
    routines[current_step](); 

    while (true) {
        // UP BUTTON: Increment step and execute
        if (master.get_digital_new_press(pros::E_CONTROLLER_DIGITAL_UP)) {
            if (current_step < 20) {
                current_step++;
                pros::lcd::print(2, "Current Step: %d", current_step);
                routines[current_step](); // Call the mapped function
            }
        } 
        // DOWN BUTTON: Decrement step and execute
        else if (master.get_digital_new_press(pros::E_CONTROLLER_DIGITAL_DOWN)) {
            if (current_step > 1) {
                current_step--;
                pros::lcd::print(2, "Current Step: %d", current_step);
                routines[current_step](); // Call the mapped function
            }
        }

        pros::delay(20);
    }
}
